{
  "$schema": "https://swc.rs/schema.json",
  "sourceMaps": true,
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": true,
      "dynamicImport": true
    }
  },
  "minify": true,
  "module": {
    "type": "commonjs",
    "strictMode": true
  },
  "exclude": ["generated/**/*", "**/node_modules/**/*", "**/*.d.ts"]
}
